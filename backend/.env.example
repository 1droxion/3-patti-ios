# Persistent database: create a Supabase project, run schema.sql, then set these on Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Must be a long random server secret. Do not put this in Flutter or GitHub.
AUTH_SECRET=
AUTH_REQUIRED=true

# Social/demo wallet defaults. Cash mode should never use free convertible demo chips.
INITIAL_DEMO_CHIPS=10000
TABLE_ENTRY_CHIPS=10000

# Real-money master switch. Keep false until authorized.
CASH_MODE_ENABLED=false
REAL_MONEY_APPROVED=false
IDENTITY_PROVIDER_READY=false
KYC_PROVIDER_READY=false
GEOLOCATION_PROVIDER_READY=false
PAYMENT_PROVIDER_APPROVED=false
APPROVED_CASH_STATES=NJ

# Individual provider switches remain false until provider approval + credentials exist.
PAYPAL_LIVE=false
BANK_PAYOUTS_LIVE=false
APPLE_PAY_LIVE=false
CASH_APP_LIVE=false
CARD_PAYMENTS_LIVE=false


# V1.5 KYC / live activation gates
# Prefer the newer Supabase secret key when available; legacy service-role is still accepted by this build.
SUPABASE_SECRET_KEY=
KYC_HASH_PEPPER=
KYC_WEBHOOK_SECRET=
REGULATORY_APPROVAL_ID=
PAYMENT_APPROVAL_ID=
APPROVED_CASH_STATES=NJ
